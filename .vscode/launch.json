{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch My Project",
            "type": "cppdbg", 
            "request": "launch",
            "program": "${workspaceFolder}/build/project",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb", // Change to "lldb" if you are on a Mac
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}